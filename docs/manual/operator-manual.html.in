<title>Pole Position Station Handbook</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap">

<style>
:root {
  --ground: #E9ECED;
  --surface: #FFFFFF;
  --surface-sunk: #F3F5F6;
  --ink: #161D21;
  --ink-soft: #3D474D;
  --muted: #636E74;
  --rule: #C6CDD0;
  --rule-soft: #DDE2E4;
  --accent: #276A8E;
  --accent-soft: #E2ECF2;
  --reject: #B42318;
  --reject-soft: #F8E7E5;
  --caution: #8A5D00;
  --caution-soft: #FBF0DA;
  --good: #2F6B4F;
  --good-soft: #E4EFE9;
  --shadow: 0 1px 2px rgba(22, 29, 33, .07), 0 8px 24px rgba(22, 29, 33, .05);
  --display: "Archivo", "Helvetica Neue", Arial, sans-serif;
  --body: "IBM Plex Sans", "Segoe UI", system-ui, sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, "Cascadia Mono", Consolas, monospace;
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --ground: #101619;
    --surface: #182025;
    --surface-sunk: #131A1E;
    --ink: #E5EAEC;
    --ink-soft: #BCC6CA;
    --muted: #8D999F;
    --rule: #2B353B;
    --rule-soft: #212A2F;
    --accent: #7FB3CE;
    --accent-soft: #1B2C36;
    --reject: #EE8074;
    --reject-soft: #33201E;
    --caution: #DCA83F;
    --caution-soft: #2E2717;
    --good: #6FBB92;
    --good-soft: #16291F;
    --shadow: 0 1px 2px rgba(0, 0, 0, .4), 0 10px 28px rgba(0, 0, 0, .3);
  }
}

:root[data-theme="dark"] {
  --ground: #101619;
  --surface: #182025;
  --surface-sunk: #131A1E;
  --ink: #E5EAEC;
  --ink-soft: #BCC6CA;
  --muted: #8D999F;
  --rule: #2B353B;
  --rule-soft: #212A2F;
  --accent: #7FB3CE;
  --accent-soft: #1B2C36;
  --reject: #EE8074;
  --reject-soft: #33201E;
  --caution: #DCA83F;
  --caution-soft: #2E2717;
  --good: #6FBB92;
  --good-soft: #16291F;
  --shadow: 0 1px 2px rgba(0, 0, 0, .4), 0 10px 28px rgba(0, 0, 0, .3);
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--ground);
  color: var(--ink);
  font-family: var(--body);
  font-size: 17px;
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
}

.shell {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0;
  max-width: 1360px;
  margin: 0 auto;
  padding: 0 20px 96px;
}

@media (min-width: 1080px) {
  .shell { grid-template-columns: 250px minmax(0, 1fr); gap: 56px; padding: 0 32px 120px; }
}

/* ---------- contents rail ---------- */

.rail { display: none; }

@media (min-width: 1080px) {
  .rail {
    display: block;
    position: sticky;
    top: 0;
    align-self: start;
    max-height: 100vh;
    overflow-y: auto;
    padding: 40px 0 40px;
    border-right: 1px solid var(--rule-soft);
  }
}

.rail-title {
  font-family: var(--display);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--muted);
  margin: 0 0 14px;
}

.rail ol { list-style: none; margin: 0 0 26px; padding: 0; }
.rail li { margin: 0 0 3px; }

.rail a {
  display: flex;
  gap: 10px;
  padding: 4px 12px 4px 0;
  color: var(--ink-soft);
  text-decoration: none;
  font-size: 14px;
  line-height: 1.35;
  border-radius: 3px;
}

.rail a:hover { color: var(--accent); }
.rail a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.rail .num {
  font-family: var(--mono);
  font-size: 12px;
  color: var(--muted);
  font-variant-numeric: tabular-nums;
  padding-top: 2px;
}

.rail .sub a { padding-left: 26px; font-size: 13px; color: var(--muted); }

/* ---------- masthead ---------- */

.masthead { padding: 56px 0 40px; border-bottom: 3px solid var(--ink); }

.eyebrow {
  font-family: var(--display);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: var(--accent);
  margin: 0 0 18px;
}

h1 {
  font-family: var(--display);
  font-size: clamp(38px, 6vw, 62px);
  font-weight: 700;
  line-height: 1.02;
  letter-spacing: -.02em;
  margin: 0 0 18px;
  text-wrap: balance;
}

.standfirst {
  font-size: 20px;
  line-height: 1.5;
  color: var(--ink-soft);
  max-width: 60ch;
  margin: 0 0 34px;
}

.docmeta {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 1px;
  background: var(--rule-soft);
  border: 1px solid var(--rule-soft);
}

.docmeta div { background: var(--surface); padding: 12px 14px; }

.docmeta dt {
  font-family: var(--display);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--muted);
  margin: 0 0 4px;
}

.docmeta dd {
  margin: 0;
  font-family: var(--mono);
  font-size: 14px;
  color: var(--ink);
}

/* ---------- structure ---------- */

main { min-width: 0; }

.part { padding-top: 68px; scroll-margin-top: 16px; }

.part-head { display: flex; align-items: baseline; gap: 16px; margin-bottom: 8px; }

.part-num {
  font-family: var(--mono);
  font-size: 13px;
  font-weight: 500;
  color: var(--accent);
  letter-spacing: .06em;
  padding-top: 6px;
}

h2 {
  font-family: var(--display);
  font-size: clamp(27px, 3.4vw, 36px);
  font-weight: 700;
  letter-spacing: -.015em;
  line-height: 1.12;
  margin: 0;
  text-wrap: balance;
}

.part-intro { color: var(--ink-soft); max-width: 66ch; margin: 10px 0 0; }

h3 {
  font-family: var(--display);
  font-size: 21px;
  font-weight: 600;
  letter-spacing: -.005em;
  margin: 42px 0 10px;
  text-wrap: balance;
}

h4 {
  font-family: var(--display);
  font-size: 15px;
  font-weight: 600;
  margin: 28px 0 6px;
  color: var(--ink);
}

p { max-width: 68ch; margin: 0 0 16px; }
ul, ol { max-width: 66ch; padding-left: 22px; margin: 0 0 18px; }
li { margin-bottom: 7px; }
li > ul, li > ol { margin-top: 7px; }

strong { font-weight: 600; }
a { color: var(--accent); }

code {
  font-family: var(--mono);
  font-size: .88em;
  background: var(--surface-sunk);
  border: 1px solid var(--rule-soft);
  border-radius: 3px;
  padding: 1px 5px;
}

pre {
  font-family: var(--mono);
  font-size: 13.5px;
  line-height: 1.6;
  background: var(--surface-sunk);
  border: 1px solid var(--rule-soft);
  border-left: 3px solid var(--accent);
  padding: 16px 18px;
  overflow-x: auto;
  margin: 0 0 20px;
}

pre code { background: none; border: none; padding: 0; font-size: inherit; }

/* ---------- figures ---------- */

figure { margin: 26px 0 30px; }

figure img {
  display: block;
  width: 100%;
  height: auto;
  border: 1px solid var(--rule);
  box-shadow: var(--shadow);
  background: var(--surface);
}

figcaption {
  display: flex;
  gap: 10px;
  margin-top: 10px;
  font-size: 14px;
  line-height: 1.5;
  color: var(--muted);
  max-width: 74ch;
}

figcaption b {
  font-family: var(--mono);
  font-weight: 500;
  color: var(--accent);
  white-space: nowrap;
}

/* ---------- callouts ---------- */

.note {
  border: 1px solid var(--rule-soft);
  border-left: 4px solid var(--accent);
  background: var(--surface);
  padding: 16px 18px;
  margin: 0 0 22px;
  max-width: 70ch;
}

.note > :last-child { margin-bottom: 0; }

.note .tag {
  display: block;
  font-family: var(--display);
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: .15em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 6px;
}

.note.stop { border-left-color: var(--reject); background: var(--reject-soft); }
.note.stop .tag { color: var(--reject); }
.note.care { border-left-color: var(--caution); background: var(--caution-soft); }
.note.care .tag { color: var(--caution); }

/* ---------- tables ---------- */

.tablewrap { overflow-x: auto; margin: 0 0 24px; border: 1px solid var(--rule-soft); }

table {
  border-collapse: collapse;
  width: 100%;
  min-width: 520px;
  font-size: 14.5px;
  background: var(--surface);
}

th, td { text-align: left; padding: 9px 14px; border-bottom: 1px solid var(--rule-soft); vertical-align: top; }

th {
  font-family: var(--display);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--muted);
  background: var(--surface-sunk);
  white-space: nowrap;
}

tbody tr:last-child td { border-bottom: none; }
td.num, th.num { text-align: center; font-family: var(--mono); font-variant-numeric: tabular-nums; }
td code { background: none; border: none; padding: 0; }

.pill {
  display: inline-block;
  font-family: var(--display);
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: .09em;
  text-transform: uppercase;
  padding: 2px 8px;
  border: 1px solid currentColor;
}

.pill.pass { color: var(--good); background: var(--good-soft); }
.pill.fail { color: var(--reject); background: var(--reject-soft); }

/* ---------- checklists ---------- */

.check { list-style: none; padding-left: 0; max-width: 70ch; }

.check li {
  position: relative;
  padding-left: 32px;
  margin-bottom: 10px;
}

.check li::before {
  content: "";
  position: absolute;
  left: 0;
  top: 4px;
  width: 16px;
  height: 16px;
  border: 1.5px solid var(--muted);
  background: var(--surface);
}

/* ---------- timing diagram ---------- */

.diagram {
  background: var(--surface);
  border: 1px solid var(--rule-soft);
  padding: 22px 20px 14px;
  margin: 26px 0 12px;
  overflow-x: auto;
}

.diagram svg { display: block; min-width: 560px; width: 100%; height: auto; }

.wire { fill: none; stroke-width: 2.5; stroke-linejoin: miter; }
.wire-in { stroke: var(--accent); }
.wire-out { stroke: var(--ink-soft); }
.wire-pass { stroke: var(--good); }
.wire-fail { stroke: var(--reject); }
.axis { stroke: var(--rule); stroke-width: 1; }
.gridline { stroke: var(--rule-soft); stroke-width: 1; stroke-dasharray: 3 4; }
.sig {
  font-family: var(--mono);
  font-size: 12px;
  fill: var(--ink-soft);
}
.stage {
  font-family: var(--display);
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: .1em;
  fill: var(--muted);
  text-transform: uppercase;
}

/* ---------- glossary ---------- */

.glossary { border-top: 1px solid var(--rule); max-width: 74ch; }
.glossary div { display: grid; gap: 2px 20px; padding: 13px 0; border-bottom: 1px solid var(--rule-soft); }
@media (min-width: 700px) { .glossary div { grid-template-columns: 200px 1fr; } }
.glossary dt { font-family: var(--display); font-weight: 600; font-size: 15px; }
.glossary dd { margin: 0; color: var(--ink-soft); font-size: 15.5px; }

footer {
  margin-top: 80px;
  padding-top: 26px;
  border-top: 3px solid var(--ink);
  font-size: 14px;
  color: var(--muted);
  max-width: 70ch;
}

@media (prefers-reduced-motion: reduce) {
  * { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
}
</style>

